rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow anyone to read the sectors, only admins can write
    match /sectors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow anyone to read notifications, only admins can write
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    // Allow anyone to submit a contact form, but only admins can read/manage
    match /contact_submissions/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null; 
    }
    
    // Default Fallback: Everything else is strictly locked to Admins only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
